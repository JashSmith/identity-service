            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Helper function to check if a value is valid",
                  "function isValid(value) {",
                  "    return value !== null && value !== undefined && value !== \"\";",
                  "}",
                  "",
                  "// 1. Parse the JSON response body",
                  "let responseData = pm.response.json();",
                  "",
                  "",
                  "// 2. (Optional) Write tests to verify the tokens were actually returned",
                  "pm.test(\"Access token is present in response\", function () {",
                  "    pm.expect(responseData.access_token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Refresh token is present in response\", function () {",
                  "    pm.expect(responseData.refresh_token).to.not.be.empty;",
                  "});",
                  "",
                  "// 3. Set the variables to the current Postman environment",
                  "// 1. Check and set Access Token",
                  "if (isValid(responseData.access_token)) {",
                  "    pm.environment.set(\"access_token\", responseData.access_token);",
                  "    console.log(\"Success: access_token set in environment.\");",
                  "} else {",
                  "    console.error(\"Error: access_token is missing or null in the response!\");",
                  "}",
                  "",
                  "// 2. Check and set Refresh Token",
                  "if (isValid(responseData.refresh_token)) {",
                  "    pm.environment.set(\"refresh_token\", responseData.refresh_token);",
                  "    console.log(\"Success: refresh_token set in environment.\");",
                  "} else {",
                  "    console.error(\"Error: refresh_token is missing or null in the response!\");",
                  "}",
                  "",
                  "// 3. Check and set Token Type",
                  "if (isValid(responseData.token_type)) {",
                  "    pm.environment.set(\"token_type\", responseData.token_type);",
                  "    console.log(\"Success: token_type set in environment.\");",
                  "} else {",
                  "    console.error(\"Error: token_type is missing or null in the response!\");",
                  "}",
                  "",
                  "// 4. (Optional but recommended) Calculate and save the expiration time",
                  "// This is useful if you want to write pre-request scripts to automatically refresh the token when it expires",
                  "if (isValid(responseData.expires_in)) {",
                  "    let expiresIn = responseData.expires_in; // 300 seconds",
                  "    let expiryTimestamp = Math.floor(Date.now() / 1000) + expiresIn;",
                  "    pm.environment.set(\"access_token_expiry\", expiryTimestamp);",
                  "}"
