{
  "realm": "company",
  "enabled": true,
  "displayName": "Company",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "Offline access"
      },
      {
        "name": "uma_authorization",
        "description": "UMA authorization"
      },
      {
        "name": "Identity.Users.Read",
        "description": "Read users / directory"
      },
      {
        "name": "Identity.Roles.Read",
        "description": "Read roles"
      },
      {
        "name": "Identity.Permissions.Read",
        "description": "Read/list permissions"
      },
      {
        "name": "Identity.Permissions.Register",
        "description": "Register permission manifests"
      },
      {
        "name": "Identity.Keys.View",
        "description": "View signing keys"
      },
      {
        "name": "Identity.Keys.Generate",
        "description": "Generate signing keys"
      },
      {
        "name": "Identity.Keys.Import",
        "description": "Import signing keys"
      },
      {
        "name": "Identity.Keys.Stage",
        "description": "Stage keys passive"
      },
      {
        "name": "Identity.Keys.Validate",
        "description": "Validate keys"
      },
      {
        "name": "Identity.Keys.Activate",
        "description": "Activate keys"
      },
      {
        "name": "Identity.Keys.Passivate",
        "description": "Passivate keys"
      },
      {
        "name": "Identity.Keys.Retire",
        "description": "Retire keys"
      },
      {
        "name": "Identity.Keys.Destroy",
        "description": "Destroy keys"
      },
      {
        "name": "Identity.Keys.Rotate",
        "description": "Rotate keys"
      },
      {
        "name": "Identity.Keys.EmergencyRotate",
        "description": "Emergency rotate"
      },
      {
        "name": "Identity.Keys.Rollback",
        "description": "Rollback keys"
      },
      {
        "name": "Identity.Keys.History",
        "description": "View key history"
      }
    ]
  },
  "groups": [
    {
      "name": "key-admins",
      "realmRoles": [
        "Identity.Keys.View",
        "Identity.Keys.Generate",
        "Identity.Keys.Import",
        "Identity.Keys.Stage",
        "Identity.Keys.Validate",
        "Identity.Keys.Activate",
        "Identity.Keys.Passivate",
        "Identity.Keys.Retire",
        "Identity.Keys.Destroy",
        "Identity.Keys.Rotate",
        "Identity.Keys.EmergencyRotate",
        "Identity.Keys.Rollback",
        "Identity.Keys.History"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "identity-facade",
      "name": "Identity Facade",
      "description": "Public facade \u2014 proxy for login/refresh/introspect/logout",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "facade-development-only",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300",
        "client.secret.creation.time": "0"
      },
      "protocolMappers": [
        {
          "name": "permission-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "permission-singular-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permission",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "facade-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "identity-facade",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sub-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "subject-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order Service (sample permission registrant)",
      "description": "Sample consumer \u2014 registers its [RequirePermission] actions at startup",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "order-service-development-only",
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "client.secret.creation.time": "0"
      },
      "protocolMappers": [
        {
          "name": "permission-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "permission-singular-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permission",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "identity-facade-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "identity-facade",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "subject-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "permissions-mapper",
      "description": "Maps realm roles into permission / permissions claims for the facade authorizer",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "permission-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "permission-singular-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permission",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": [
        "Identity.Permissions.Register"
      ],
      "email": "service-account-order-service@company.local",
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Identity.Users.Read",
        "Identity.Roles.Read",
        "Identity.Permissions.Read",
        "Identity.Permissions.Register",
        "Identity.Keys.View",
        "Identity.Keys.Generate",
        "Identity.Keys.Import",
        "Identity.Keys.History",
        "Identity.Keys.Rotate",
        "Identity.Keys.Rollback",
        "Identity.Keys.Destroy"
      ],
      "groups": [
        "key-admins"
      ],
      "email": "admin@company.local",
      "requiredActions": []
    }
  ]
}