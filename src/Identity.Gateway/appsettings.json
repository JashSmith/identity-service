{
  "Identity": {
    "Authority": "http://localhost:8080/realms/company",
    "Audience": "identity-gateway",
    "RequireHttpsMetadata": false,
    "Server": "http://localhost:5080",
    "Keycloak": {
      "BaseUrl": "http://localhost:8080",
      "Realm": "company",
      "AdminAuthority": "http://localhost:8080/realms/master",
      "ClientId": "identity-gateway"
    },
    "PublicBaseUrl": "http://localhost:5080",
    "PermissionRegistration": {
      "RetryInitialDelaySeconds": 2,
      "MaximumRetries": 8
    },
    "Redis": {
      "Configuration": "localhost:6379",
      "CatalogTtlSeconds": 60,
      "AuthorizationSnapshotTtlSeconds": 30
    },
    "KeycloakAdmin": {
      "BaseUrl": "http://localhost:8080",
      "Realm": "company",
      "AdminClientId": "identity-gateway-admin"
    }
  },
  "Database": {
    "Provider": "postgres",
    "ConnectionStrings": {}
  }
}