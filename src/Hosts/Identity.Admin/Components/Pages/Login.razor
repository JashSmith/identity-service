@page "/login"
@using Microsoft.Extensions.Options
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject IOptions<ConsoleOptions> Options

<PageTitle>ورود | کنسول مدیریت هویت</PageTitle>

<div class="av-login">
    <section class="av-login__panel">
        <div class="av-login__top"><ThemeSwitch /></div>
        <div class="av-login__card">
            <h1 class="av-login__title">ورود به کنسول مدیریت</h1>
            <p class="av-login__hint">سازمان خود را انتخاب کنید تا به صفحه ورود آن هدایت شوید.</p>
            @if (Options.Value.Tenants.Count == 0)
            {
                <EmptyState Icon="domain_disabled" Title="هیچ سازمانی پیکربندی نشده است">
                    بخش <span class="ltr">Console:Tenants</span> را در تنظیمات کنسول کامل کنید.
                </EmptyState>
            }
            <ul class="av-login__tenants">
                @foreach (var tenant in Options.Value.Tenants)
                {
                    <li>
                        <a class="av-login__tenant" href="@($"/auth/login/{Uri.EscapeDataString(tenant.Id)}?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}")">
                            <span class="rzi" aria-hidden="true">domain</span>
                            <span class="av-login__tenant-name">@tenant.DisplayName</span>
                            <span class="ltr av-login__tenant-id">@tenant.Id</span>
                            <span class="rzi av-login__tenant-go" aria-hidden="true">arrow_back</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
    <section class="av-login__art" aria-hidden="true">
        <Girih Class="av-login__pattern" Size="56" />
        <div class="av-login__art-text">
            <span class="av-login__art-title">هویت آواش</span>
            <span class="av-login__art-caption">یک ورود برای همه سامانه‌های سازمان</span>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
