@page "/"
@inherits ConsolePage

<PageTitle>داشبورد | کنسول مدیریت هویت</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">داشبورد</RadzenText>

<RadzenRow Gap="1rem">
    @foreach (var card in cards)
    {
        <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
            <RadzenCard>
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Overline">@card.Title</RadzenText>
                    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(card.Value?.ToString() ?? "—")</RadzenText>
                    <RadzenLink Path="@card.Path" Text="مشاهده" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    }
</RadzenRow>

@code {
    private sealed record Card(string Title, string Path, int? Value);
    private List<Card> cards = [];

    protected override async Task OnInitializedAsync()
    {
        var list = new List<Card>();
        if (await Can(Permissions.UsersRead))
            await RunAsync(async () => list.Add(new("کاربران", "/users",
                (await Api.GetAsync<PagedResponse<UserDto>>("api/identity/users?pageSize=1")).Total)));
        if (await Can(Permissions.RolesRead))
            await RunAsync(async () => list.Add(new("نقش‌ها", "/roles",
                (await Api.GetAsync<List<BusinessRoleDto>>("api/identity/business-roles")).Count)));
        if (await Can(Permissions.ApplicationsRead))
            await RunAsync(async () => list.Add(new("اپلیکیشن‌ها", "/applications",
                (await Api.GetAsync<List<ApplicationDto>>("api/identity/applications")).Count)));
        if (await Can(Permissions.PermissionsRead))
            await RunAsync(async () => list.Add(new("دسترسی‌ها", "/applications",
                (await Api.GetAsync<List<CatalogPermissionDto>>("api/identity/permissions")).Count)));
        cards = list;
    }
}
