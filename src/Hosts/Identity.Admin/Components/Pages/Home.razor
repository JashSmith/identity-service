@page "/"
@inherits ConsolePage

<PageTitle>داشبورد | کنسول مدیریت هویت</PageTitle>

<PageHeader Title="داشبورد" Icon="space_dashboard">
    <Description>نمای کلی این سازمان. هر کارت فقط برای مدیرانی دیده می‌شود که اجازه خواندن آن بخش را دارند.</Description>
</PageHeader>

@if (cards.Count == 0 && loaded)
{
    <EmptyState Icon="lock" Title="بخشی برای نمایش ندارید">
        حساب شما هیچ‌یک از دسترسی‌های خواندن کنسول را ندارد. از مدیر سامانه بخواهید نقش مناسب را به شما بدهد.
    </EmptyState>
}

<section class="av-stats" aria-label="شاخص‌های کلیدی">
    @foreach (var card in cards)
    {
        <StatCard Label="@card.Label" Icon="@card.Icon" Tone="@card.Tone" Path="@card.Path" Value="@card.Value" Failed="@card.Failed" />
    }
</section>

@code {
    private sealed class Card(string label, string icon, string tone, string path)
    {
        public string Label { get; } = label;
        public string Icon { get; } = icon;
        public string Tone { get; } = tone;
        public string Path { get; } = path;
        public long? Value { get; set; }
        public bool Failed { get; set; }
    }

    private readonly List<Card> cards = [];
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        var loads = new List<Task>();
        if (await Can(Permissions.UsersRead))
            loads.Add(Load(new("کاربران", "group", "primary", "/users"),
                async () => (await Api.GetAsync<PagedResponse<UserDto>>("api/identity/users?pageSize=1")).Total ?? 0));
        if (await Can(Permissions.RolesRead))
            loads.Add(Load(new("نقش‌ها", "badge", "secondary", "/roles"),
                async () => (await Api.GetAsync<List<BusinessRoleDto>>("api/identity/business-roles")).Count));
        if (await Can(Permissions.ApplicationsRead))
            loads.Add(Load(new("اپلیکیشن‌ها", "apps", "info", "/applications"),
                async () => (await Api.GetAsync<List<ApplicationDto>>("api/identity/applications")).Count));
        if (await Can(Permissions.PermissionsRead))
            loads.Add(Load(new("دسترسی‌ها", "key", "warning", "/applications"),
                async () => (await Api.GetAsync<List<CatalogPermissionDto>>("api/identity/permissions")).Count));
        loaded = true;
        await Task.WhenAll(loads);
    }

    // Each card loads on its own: one failing section leaves the others visible (partial dashboard).
    private async Task Load(Card card, Func<Task<long>> read)
    {
        cards.Add(card);
        if (!await RunAsync(async () => card.Value = await read())) card.Failed = true;
        StateHasChanged();
    }
}
