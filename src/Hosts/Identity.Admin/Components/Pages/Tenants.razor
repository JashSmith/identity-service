@page "/tenants"
@inherits ConsolePage

<PageTitle>سازمان‌ها | کنسول مدیریت هویت</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">سازمان‌ها</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4">
    هر سازمان یک Realm جداگانه در Keycloak است و کاربران، نقش‌ها و تنظیمات خود را دارد. برای مدیریت سازمان دیگر از حساب خارج شوید و آن سازمان را انتخاب کنید.
</RadzenText>

<RadzenDataGrid TItem="TenantView" Data="@tenants" IsLoading="@Busy" EmptyText="سازمانی پیکربندی نشده است">
    <Columns>
        <RadzenDataGridColumn Property="DisplayName" Title="نام" />
        <RadzenDataGridColumn Title="شناسه"><Template Context="t"><span class="ltr">@t.Id</span></Template></RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Realm"><Template Context="t"><span class="ltr">@t.Realm</span></Template></RadzenDataGridColumn>
        <RadzenDataGridColumn Title="" Width="120px">
            <Template Context="t">
                @if (t.IsDefault)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="پیش‌فرض" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<TenantView> tenants = [];

    protected override Task OnInitializedAsync() =>
        RunAsync(async () => tenants = await Api.GetAsync<List<TenantView>>("api/identity/tenants"));
}
