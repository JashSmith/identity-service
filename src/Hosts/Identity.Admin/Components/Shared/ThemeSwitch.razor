@* Light / dark / system switch. Plain buttons handled by wwwroot/js/theme.js, so it also works on static pages. *@
<div class="av-theme-switch" role="group" aria-label="حالت نمایش">
    <button type="button" class="av-theme-switch__option" data-theme-option="light" title="روشن" aria-label="حالت روشن">
        <span class="rzi" aria-hidden="true">light_mode</span>
    </button>
    <button type="button" class="av-theme-switch__option" data-theme-option="system" title="مطابق سیستم" aria-label="مطابق تنظیم سیستم">
        <span class="rzi" aria-hidden="true">contrast</span>
    </button>
    <button type="button" class="av-theme-switch__option" data-theme-option="dark" title="تیره" aria-label="حالت تیره">
        <span class="rzi" aria-hidden="true">dark_mode</span>
    </button>
</div>
