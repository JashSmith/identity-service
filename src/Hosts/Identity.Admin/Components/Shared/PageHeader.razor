@* The title row of every console page: one h1 (focused after navigation), an optional line of context and actions. *@
<header class="av-page-header">
    <div class="av-page-header__text">
        @if (Breadcrumb is not null)
        {
            <nav class="av-page-header__crumb" aria-label="مسیر">@Breadcrumb</nav>
        }
        <h1 class="av-page-header__title" tabindex="-1">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <RadzenIcon Icon="@Icon" class="av-page-header__icon" aria-hidden="true" />
            }
            @Title
        </h1>
        @if (Description is not null)
        {
            <p class="av-page-header__description">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="av-page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
