{
  "realm": "company",
  "enabled": true,
  "displayName": "Company",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "Offline access"
      },
      {
        "name": "uma_authorization",
        "description": "UMA authorization"
      },
      {
        "name": "identity.users.read",
        "description": "Read users / directory"
      },
      {
        "name": "identity.users.manage",
        "description": "Manage users including scoped assignments"
      },
      {
        "name": "identity.roles.read",
        "description": "Read business roles"
      },
      {
        "name": "identity.roles.manage",
        "description": "Manage business (composite) roles"
      },
      {
        "name": "identity.scopes.read",
        "description": "Read scoped access assignments"
      },
      {
        "name": "identity.scopes.manage",
        "description": "Manage scoped access assignments"
      },
      {
        "name": "identity.permissions.read",
        "description": "Read permissions catalog"
      },
      {
        "name": "identity.permissions.register",
        "description": "Register service permission manifests"
      }
    ]
  },
  "groups": [
    {
      "name": "super-admins",
      "attributes": {
        "description": [
          "Always-present unrestricted administrators; every registered client role is auto-mapped to this group"
        ]
      },
      "realmRoles": [
        "identity.users.read",
        "identity.users.manage",
        "identity.roles.read",
        "identity.roles.manage",
        "identity.scopes.read",
        "identity.scopes.manage",
        "identity.permissions.read",
        "identity.permissions.register"
      ]
    },
    {
      "name": "iam-scope-registry",
      "attributes": {
        "scope.region": [
          "{\"displayName\":\"Region\",\"description\":\"Geographic region\",\"isActive\":true,\"valueType\":\"String\"}"
        ],
        "resource.Orders": [
          "region"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "identity-gateway-admin",
      "name": "Identity Gateway (admin service account)",
      "description": "Service account the gateway uses for the Admin REST API. No user login flows.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GATEWAY_ADMIN_CLIENT_SECRET}",
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "client.secret.creation.time": "0"
      }
    },
    {
      "clientId": "identity-gateway",
      "name": "Identity Gateway",
      "description": "Public gateway — proxy for login/refresh/introspect/logout",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GATEWAY_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "iam-access",
        "authz-scopes",
        "permissions-mapper"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "attributes": {
        "access.token.lifespan": "300",
        "client.secret.creation.time": "0"
      },
      "protocolMappers": [

        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "identity-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sub-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "subject-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "iam-access-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "iam.scoped_access",
            "claim.name": "iam_access",
            "jsonType.label": "String",
            "multivalued": "false",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order Service (sample permission registrant)",
      "description": "Sample consumer — registers its [RequirePermission] actions at startup",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}",
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "client.secret.creation.time": "0"
      },
      "protocolMappers": [

        {
          "name": "identity-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "identity-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "subject-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "iam-access-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "iam.scoped_access",
            "claim.name": "iam_access",
            "jsonType.label": "String",
            "multivalued": "false",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "permissions-mapper",
      "description": "Maps realm roles into permission / permissions claims for the gateway authorizer",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "permission-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "client-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "iam-access",
      "description": "Maps iam.scoped_access user attribute to iam_access claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false",
        "gui.order": "",
        "consent.screen.text": ""
      },
      "protocolMappers": [
        {
          "name": "iam-access-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "iam.scoped_access",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "iam_access",
            "jsonType.label": "String",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "name": "authz-scopes",
      "description": "Maps authz.scope.* user/group attributes to flat scopes claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    }
  ],
  "users": [
    {
      "username": "service-account-identity-gateway-admin",
      "enabled": true,
      "serviceAccountClientId": "identity-gateway-admin",
      "email": "service-account-identity-gateway-admin@company.local",
      "emailVerified": true,
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "manage-realm",
          "view-users",
          "manage-users",
          "query-users",
          "query-groups",
          "view-clients",
          "manage-clients",
          "query-clients",
          "view-events",
          "view-identity-providers",
          "manage-identity-providers"
        ]
      },
      "requiredActions": []
    },
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": [
        "identity.permissions.register"
      ],
      "email": "service-account-order-service@company.local",
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "identity.users.read",
        "identity.users.manage",
        "identity.roles.read",
        "identity.roles.manage",
        "identity.scopes.read",
        "identity.scopes.manage",
        "identity.permissions.read",
        "identity.permissions.register"
      ],
      "groups": [
        "super-admins"
      ],
      "email": "admin@company.local",
      "requiredActions": []
    }
  ]
}