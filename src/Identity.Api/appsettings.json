{
  "Identity": {
    "Persistence": { "UseSqlite": false },
    "DataProtection": { "KeysPath": "identity-data-protection-keys" },
    "Authority": "https://localhost:7001",
    "Audience": "identity-api",
    "Tokens": {
      "StoragePath": "identity-signing-keys.json",
      "KeySize": 2048,
      "ActiveKeyLifetime": "30.00:00:00",
      "KeyOverlapLifetime": "14.00:00:00",
      "AutomaticRotation": true
    },
    "ExternalProviders": {
      "Oidc": {
        "Authority": "",
        "ClientId": "",
        "TimeoutSeconds": 10
      },
      "Keycloak": {
        "Authority": "",
        "ClientId": "",
        "TimeoutSeconds": 10
      }
    },
    "PermissionManifest": {
      "ServiceId": "identity-service",
      "ServiceName": "Identity Service",
      "Version": "1.0.0",
      "ManifestVersion": "1"
    },
    "Messaging": {
      "RabbitMq": {
        "Enabled": false,
        "ConsumeEnabled": false,
        "ConnectionString": "amqp://guest:guest@localhost:5672/"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5080" },
      "Https": { "Url": "https://0.0.0.0:5443", "Protocols": "Http1AndHttp2" }
    }
  }
}
