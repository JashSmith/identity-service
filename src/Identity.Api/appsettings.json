{
  "Identity": {
    "Authority": "http://localhost:8080/realms/company",
    "Audience": "order-service",
    "Server": "http://localhost:5080",
    "Keycloak": {
      "AdminAuthority": "http://localhost:8080/realms/master",
      "Realm": "company",
      "ClientId": "identity-facade"
    },
    "PermissionRegistration": {
      "RetryInitialDelaySeconds": 2,
      "MaximumRetries": 8
    },
    "Redis": {
      "Configuration": "localhost:6379",
      "CatalogTtlSeconds": 60,
      "AuthorizationSnapshotTtlSeconds": 30
    },
    "KeyManagement": {
      "Realm": "company",
      "GracePeriod": "01:00:00",
      "RetentionAfterGrace": "1.00:00:00",
      "RotationLockTtl": "00:05:00",
      "ConvergenceTimeout": "00:02:00",
      "ConvergencePollInterval": "00:00:03",
      "DefaultSize": 2048,
      "KidPrefix": "iam-rsa-"
    },
    "Vault": {
      "Address": "http://vault:8200",
      "Mount": "secret",
      "Prefix": "identity/keys",
      "Timeout": "00:00:10",
      "Token": ""
    },
    "KeycloakAdmin": {
      "BaseUrl": "http://keycloak:8080",
      "Realm": "company",
      "AdminClientId": "admin-cli"
    },
    "KeyMetadata": {
      "Provider": "sqlite",
      "_comment": "Use 'oracle' in production, 'npgsql' or 'sqlite' in CI. Never store private keys here."
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "ConnectionStrings": {
    "KeyMetadata": "Data Source=identity_keys.db"
  }
}
